# Structly web app — environment variables.
#
# The Plex token is NOT configured here: it is entered in the app's
# "Plex Settings" modal and persisted to ~/.structly_settings.json
# (see settings_store.py). There is no PLEX_TOKEN env var any more.
#
# PORT is the only variable the app itself uses — it is read by the
# Procfile's uvicorn command. The server binds to 127.0.0.1 (localhost
# only); it has no authentication, so do not expose it to a network.
PORT=8000
